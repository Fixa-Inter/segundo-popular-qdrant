# Endereço de conexão PostgreSQL, por exemplo postgresql://usuario:senha@host:5432/banco?sslmode=require
DATABASE_URL=

# Endereço de conexão Redis; use rediss:// quando TLS for obrigatório
REDIS_URL=

# Endereço do Qdrant e chave de API, se necessária
QDRANT_URL=
QDRANT_API_KEY=

# Chave de API da OpenAI
OPENAI_API_KEY=

# Use a mesma dimensão em todas as collections Qdrant deste modelo
EMBEDDING_DIMENSION=768
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Reconsulta alterações recentes para cobrir atrasos e transações concorrentes
SYNC_OVERLAP_MINUTES=20
SYNC_BATCH_SIZE=32
SYNC_LOCK_TTL_SECONDS=3600
QDRANT_TIMEOUT_SECONDS=60
LOG_LEVEL=INFO
